      },
      "required": ["request","planHash","sources","decisions","omitted","bytes","payload"],
      "additionalProperties": false
    },
    "AdapterV1": {"type":"object","properties":{"id":{"$ref":"#/$defs/Id"},"version":{"$ref":"#/$defs/Pos"},"schemaHash":{"$ref":"#/$defs/Hash"}},"required":["id","version","schemaHash"],"additionalProperties":false},
    "RunLimitsV1": {
      "type": "object",
      "properties": {
        "maxTurns": {"type":"integer","minimum":1,"maximum":64},
        "maxAttempts": {"type":"integer","minimum":1,"maximum":4},
        "maxModelCalls": {"type":"integer","minimum":1,"maximum":64},
        "maxToolCalls": {"type":"integer","minimum":1,"maximum":64},
        "maxConcurrentTools": {"type":"integer","minimum":1,"maximum":8},
        "contextWindow": {"type":"integer","minimum":1,"maximum":262144},
        "maxInputChars": {"type":"integer","minimum":1,"maximum":262144},
        "deadlineMs": {"type":"integer","minimum":1,"maximum":3600000}
      },
      "required": ["maxTurns","maxAttempts","maxModelCalls","maxToolCalls","maxConcurrentTools","contextWindow","maxInputChars","deadlineMs"],
      "additionalProperties": false
    },
    "RunPlanV1": {
      "type": "object",
      "properties": {
        "ref": {"$ref":"#/$defs/RefV1"},
        "admission": {"$ref":"#/$defs/RefV1"},
        "selection": {"$ref":"#/$defs/SelectionV1"},
        "tools": {"type":"array","items":{"$ref":"#/$defs/AdapterV1"},"maxItems":64},
        "input": {"$ref":"#/$defs/BlobV1"},
        "sources": {"type":"array","items":{"$ref":"#/$defs/RefV1"},"maxItems":64},
        "recipients": {"type":"array","items":{"$ref":"#/$defs/RefV1"},"maxItems":64},
        "limits": {"$ref":"#/$defs/RunLimitsV1"},
        "budget": {"$ref":"#/$defs/RefV1"},
        "upperBound": {"$ref":"#/$defs/VectorV1"},
        "costBasis": {"$ref":"#/$defs/BlobV1"},
        "expiresAt": {"$ref":"#/$defs/Time"}
      },
      "required": ["ref","admission","selection","tools","input","sources","recipients","limits","budget","upperBound","costBasis","expiresAt"],
      "additionalProperties": false
    },
    "RunCaptureV1": {
      "type": "object",
      "properties": {
        "attempt": {"$ref":"#/$defs/RefV1"},
        "admission": {"$ref":"#/$defs/RefV1"},
        "nativeIntentId": {"$ref":"#/$defs/Id"},
        "planHash": {"$ref":"#/$defs/Hash"},
        "output": {"anyOf":[{"$ref":"#/$defs/BlobV1"},{"type":"null"}]},
        "evidence": {"type":"array","items":{"$ref":"#/$defs/RefV1"},"maxItems":64},
        "usage": {"$ref":"#/$defs/UsageV1"},
        "hostOutcome": {"enum":["completed","error","cancelled","max_turns","limit_exceeded","images-unsupported","images-unavailable"]},
        "transport": {"enum":["not_started","unsettled","settled"]},
        "scope": {"enum":["not_started","unsettled","quiescent"]}
      },
      "required": ["attempt","admission","nativeIntentId","planHash","output","evidence","usage","hostOutcome","transport","scope"],
      "additionalProperties": false
    },
    "ChargeV1": {
      "type": "object",
      "properties": {
        "contract": {"const":"s15-conversation-charge/v1"},
        "id": {"$ref":"#/$defs/Id"},
        "slotId": {"$ref":"#/$defs/Id"},
        "request": {"$ref":"#/$defs/RefV1"},
        "attempt": {"anyOf":[{"$ref":"#/$defs/RefV1"},{"type":"null"}]},
        "budget": {"$ref":"#/$defs/RefV1"},
        "continuityId": {"$ref":"#/$defs/Id"},
        "continuityGeneration": {"$ref":"#/$defs/Pos"},
        "kind": {"enum":["model","read","tool","delivery","cleanup"]},
        "inputHash": {"$ref":"#/$defs/Hash"},
        "charged": {"$ref":"#/$defs/VectorV1"},
        "actual": {"$ref":"#/$defs/UsageV1"},
        "chargedAt": {"$ref":"#/$defs/Time"},
        "hash": {"$ref":"#/$defs/Hash"}
      },
      "required": ["contract","id","slotId","request","attempt","budget","continuityId","continuityGeneration","kind","inputHash","charged","actual","chargedAt","hash"],
      "additionalProperties": false
    },
    "FactsV1": {
      "type": "object",
      "properties": {
        "contract": {"const":"s15-conversation-facts/v1"},
        "ref": {"$ref":"#/$defs/RefV1"},
        "request": {"$ref":"#/$defs/RefV1"},
        "attempt": {"anyOf":[{"$ref":"#/$defs/RefV1"},{"type":"null"}]},
        "claimed": {"type":"boolean"},
        "runDispatched": {"type":"boolean"},
        "responseHash": {"anyOf":[{"$ref":"#/$defs/Hash"},{"type":"null"}]},
        "evidenceCommitted": {"type":"boolean"},
        "channelClosed": {"type":"boolean"},
        "scope": {"enum":["not_started","unsettled","quiescent"]},
        "process": {"enum":["not_started","running","stopped"]},
        "inputSent": {"type":"boolean"},
        "networkRequestHashes": {"type":"array","items":{"$ref":"#/$defs/Hash"},"maxItems":64},
        "charges": {"type":"array","items":{"$ref":"#/$defs/ChargeV1"},"maxItems":256},
        "actualUsage": {"$ref":"#/$defs/UsageV1"},
        "publication": {"enum":["unpublished","published","withheld"]},
        "cancel": {"enum":["none","requested","unknown"]},
        "hash": {"$ref":"#/$defs/Hash"}
      },
      "required": ["contract","ref","request","attempt","claimed","runDispatched","responseHash","evidenceCommitted","channelClosed","scope","process","inputSent","networkRequestHashes","charges","actualUsage","publication","cancel","hash"],
      "additionalProperties": false
    },
    "ReplyV1": {
      "type": "object",
      "properties": {
        "contract": {"const":"s15-conversation-reply/v1"},
        "ref": {"$ref":"#/$defs/RefV1"},
        "request": {"$ref":"#/$defs/RefV1"},
        "work": {"anyOf":[{"$ref":"#/$defs/RefV1"},{"type":"null"}]},
        "attempt": {"anyOf":[{"$ref":"#/$defs/RefV1"},{"type":"null"}]},
        "status": {"enum":["complete","partial","blocked","cancelled"]},
        "text": {"$ref":"#/$defs/BlobV1"},
        "evidence": {"type":"array","items":{"$ref":"#/$defs/RefV1"},"maxItems":64},
        "gaps": {"type":"array","items":{"$ref":"#/$defs/CodeV1"},"maxItems":64},
        "unblock": {"anyOf":[{"$ref":"#/$defs/RefV1"},{"type":"null"}]},
        "lineage": {"type":"array","items":{"$ref":"#/$defs/RefV1"},"maxItems":64},
        "recipient": {"$ref":"#/$defs/RefV1"},
        "createdAt": {"$ref":"#/$defs/Time"},
        "hash": {"$ref":"#/$defs/Hash"}
      },
      "required": ["contract","ref","request","work","attempt","status","text","evidence","gaps","unblock","lineage","recipient","createdAt","hash"],
      "additionalProperties": false
    },
    "EventPayloadV1": {
      "oneOf": [
        {"type":"object","properties":{"kind":{"const":"received"},"receiptHash":{"$ref":"#/$defs/Hash"}},"required":["kind","receiptHash"],"additionalProperties":false},
