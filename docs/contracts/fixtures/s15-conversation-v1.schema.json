{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jit.invalid/contracts/s15-conversation-v1.schema.json",
  "title": "Proposed s15-conversation/v1 documentation schemas; not runtime authentication",
  "$ref": "#/$defs/FixtureDocumentV1",
  "$defs": {
    "Id": {"type":"string","pattern":"^[A-Za-z0-9_-]{1,128}$"},
    "Hash": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "Nat": {"type":"integer","minimum":0,"maximum":9007199254740991},
    "Pos": {"type":"integer","minimum":1,"maximum":9007199254740991},
    "Time": {"$ref":"#/$defs/Nat"},
    "Text": {"type":"string","minLength":1,"maxLength":32768},
    "CodeV1": {
      "enum": [
        "authentication_required",
        "host_rejected",
        "origin_rejected",
        "csrf_rejected",
        "channel_unverified",
        "channel_forwarded",
        "invalid_shape",
        "invalid_data",
        "body_too_large",
        "credential_content_refused",
        "hash_mismatch",
        "continuity_unavailable",
        "continuity_capacity",
        "request_id_conflict",
        "source_event_conflict",
        "stale_revision",
        "authority_revoked",
        "stale_authority",
        "expired",
        "lineage_withdrawn",
        "selection_pinned",
        "outside_scope",
        "route_unavailable",
        "recipient_approval_required",
        "finite_budget_required",
        "cost_unknown",
        "budget_exhausted",
        "capacity_busy",
        "material_ambiguity",
        "grounding_unproven",
        "approval_required",
        "stale_approval",
        "action_denied",
        "already_claimed",
        "context_lost",
        "aborted",
        "settlement_pending",
        "publication_fenced",
        "cursor_invalid",
        "cursor_expired",
        "result_unavailable",
        "unknown_outcome",
        "adapter_unproven",
        "production_approval_required",
        "merge_authority_required",
        "owner_direction_required",
        "interpretation_unknown"
      ]
    },
    "RefV1": {"type":"object","properties":{"id":{"$ref":"#/$defs/Id"},"revision":{"$ref":"#/$defs/Pos"},"generation":{"$ref":"#/$defs/Pos"}},"required":["id","revision","generation"],"additionalProperties":false},
    "BlobV1": {"type":"object","properties":{"id":{"$ref":"#/$defs/Id"},"sha256":{"$ref":"#/$defs/Hash"},"bytes":{"type":"integer","minimum":0,"maximum":1048576},"mediaType":{"type":"string","maxLength":128,"minLength":1}},"required":["id","sha256","bytes","mediaType"],"additionalProperties":false},
    "BytesV1": {
      "type": "object",
      "properties": {"base64":{"type":"string","maxLength":5592408,"pattern":"^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"},"bytes":{"type":"integer","minimum":0,"maximum":4194304},"sha256":{"$ref":"#/$defs/Hash"}},
      "required": ["base64","bytes","sha256"],
      "additionalProperties": false
    },
    "SelectionV1": {"type":"object","properties":{"route":{"$ref":"#/$defs/RefV1"},"model":{"$ref":"#/$defs/RefV1"},"effort":{"$ref":"#/$defs/Id"}},"required":["route","model","effort"],"additionalProperties":false},
    "VectorV1": {
      "type": "object",
      "properties": {"attempts":{"$ref":"#/$defs/Nat"},"steps":{"$ref":"#/$defs/Nat"},"calls":{"$ref":"#/$defs/Nat"},"reads":{"$ref":"#/$defs/Nat"},"outputBytes":{"$ref":"#/$defs/Nat"},"activeMs":{"$ref":"#/$defs/Nat"},"spendMinor":{"type":"string","pattern":"^(0|[1-9][0-9]{0,29})$"}},
      "required": ["attempts","steps","calls","reads","outputBytes","activeMs","spendMinor"],
      "additionalProperties": false
    },
    "UsageV1": {
      "type": "object",
      "properties": {
        "attempts": {"anyOf":[{"$ref":"#/$defs/Nat"},{"type":"null"}]},
        "steps": {"anyOf":[{"$ref":"#/$defs/Nat"},{"type":"null"}]},
        "calls": {"anyOf":[{"$ref":"#/$defs/Nat"},{"type":"null"}]},
        "reads": {"anyOf":[{"$ref":"#/$defs/Nat"},{"type":"null"}]},
        "outputBytes": {"anyOf":[{"$ref":"#/$defs/Nat"},{"type":"null"}]},
        "activeMs": {"anyOf":[{"$ref":"#/$defs/Nat"},{"type":"null"}]},
        "spendMinor": {"anyOf":[{"type":"string","pattern":"^(0|[1-9][0-9]{0,29})$"},{"type":"null"}]}
      },
      "required": ["attempts","steps","calls","reads","outputBytes","activeMs","spendMinor"],
      "additionalProperties": false
    },
    "SubjectV1": {"type":"object","properties":{"resource":{"$ref":"#/$defs/RefV1"},"key":{"type":"string","minLength":1,"maxLength":4096}},"required":["resource","key"],"additionalProperties":false},
    "SpanV1": {"type":"object","properties":{"source":{"$ref":"#/$defs/RefV1"},"startByte":{"$ref":"#/$defs/Nat"},"endByte":{"$ref":"#/$defs/Pos"}},"required":["source","startByte","endByte"],"additionalProperties":false},
    "SourceV1": {
      "type": "object",
      "properties": {"ref":{"$ref":"#/$defs/RefV1"},"origin":{"enum":["owner_text","owner_decision","quote","attachment","tool","model","memory"]},"content":{"$ref":"#/$defs/BytesV1"},"lineage":{"type":"array","items":{"$ref":"#/$defs/RefV1"},"maxItems":64}},
      "required": ["ref","origin","content","lineage"],
      "additionalProperties": false
    },
    "SubmitBodyV1": {
      "type": "object",
      "properties": {
        "kind": {"const":"submit"},
        "conversation": {"$ref":"#/$defs/RefV1"},
        "text": {"type":"string","minLength":1,"maxLength":16384},
        "attachments": {"type":"array","items":{"$ref":"#/$defs/RefV1"},"maxItems":8},
        "sources": {"type":"array","items":{"$ref":"#/$defs/RefV1"},"maxItems":64},
        "continuation": {"anyOf":[{"$ref":"#/$defs/RefV1"},{"type":"null"}]}
      },
      "required": ["kind","conversation","text","attachments","sources","continuation"],
      "additionalProperties": false
    },
    "StopBodyV1": {"type":"object","properties":{"kind":{"const":"stop"},"request":{"$ref":"#/$defs/RefV1"}},"required":["kind","request"],"additionalProperties":false},
    "CommandV1": {
      "type": "object",
      "properties": {"contract":{"const":"s15-conversation-command/v1"},"requestId":{"$ref":"#/$defs/Id"},"expectedRevision":{"$ref":"#/$defs/Nat"},"body":{"oneOf":[{"$ref":"#/$defs/SubmitBodyV1"},{"$ref":"#/$defs/StopBodyV1"}]}},
      "required": ["contract","requestId","expectedRevision","body"],
      "additionalProperties": false
    },
    "ProvenanceV1": {
      "type": "object",
      "properties": {"transport":{"enum":["http","local","channel"]},"binding":{"anyOf":[{"$ref":"#/$defs/RefV1"},{"type":"null"}]},"recipient":{"$ref":"#/$defs/RefV1"},"sourceEventId":{"anyOf":[{"$ref":"#/$defs/Id"},{"type":"null"}]},"verifier":{"$ref":"#/$defs/RefV1"}},
      "required": ["transport","binding","recipient","sourceEventId","verifier"],
      "additionalProperties": false
    },
    "IngressV1": {
      "type": "object",
      "properties": {
        "contract": {"const":"s15-conversation-ingress/v1"},
        "ref": {"$ref":"#/$defs/RefV1"},
        "installationId": {"$ref":"#/$defs/Id"},
        "ownerGeneration": {"$ref":"#/$defs/Pos"},
        "requestId": {"$ref":"#/$defs/Id"},
        "commandHash": {"$ref":"#/$defs/Hash"},
        "conversation": {"$ref":"#/$defs/RefV1"},
        "source": {"$ref":"#/$defs/RefV1"},
        "provenance": {"$ref":"#/$defs/ProvenanceV1"},
        "receivedAt": {"$ref":"#/$defs/Time"},
        "hash": {"$ref":"#/$defs/Hash"}
      },
      "required": ["contract","ref","installationId","ownerGeneration","requestId","commandHash","conversation","source","provenance","receivedAt","hash"],
      "additionalProperties": false
    },
    "ReceiptV1": {
      "type": "object",
      "properties": {
        "contract": {"const":"s15-conversation-receipt/v1"},
        "requestId": {"$ref":"#/$defs/Id"},
        "ingress": {"$ref":"#/$defs/RefV1"},
        "commandHash": {"$ref":"#/$defs/Hash"},
        "interpretQueueId": {"anyOf":[{"$ref":"#/$defs/Id"},{"type":"null"}]},
        "state": {"enum":["received","stop_recorded"]},
        "committedAt": {"$ref":"#/$defs/Time"},
        "hash": {"$ref":"#/$defs/Hash"}
      },
      "required": ["contract","requestId","ingress","commandHash","interpretQueueId","state","committedAt","hash"],
      "additionalProperties": false
    },
    "CurrentV1": {
      "type": "object",
      "properties": {
        "installationId": {"$ref":"#/$defs/Id"},
        "ownerGeneration": {"$ref":"#/$defs/Pos"},
        "conversation": {"$ref":"#/$defs/RefV1"},
        "policy": {"$ref":"#/$defs/RefV1"},
        "policyHash": {"$ref":"#/$defs/Hash"},
        "purpose": {"$ref":"#/$defs/RefV1"},
        "bots": {"type":"array","items":{"$ref":"#/$defs/RefV1"},"maxItems":64},
        "resources": {"type":"array","items":{"$ref":"#/$defs/RefV1"},"maxItems":64},
        "selections": {"type":"array","items":{"$ref":"#/$defs/SelectionV1"},"maxItems":64},
        "selectionPin": {"anyOf":[{"$ref":"#/$defs/SelectionV1"},{"type":"null"}]},
        "recipients": {"type":"array","items":{"$ref":"#/$defs/RefV1"},"maxItems":64},
        "budget": {"$ref":"#/$defs/RefV1"},
        "continuityId": {"$ref":"#/$defs/Id"},
        "continuityGeneration": {"$ref":"#/$defs/Pos"},
        "ceiling": {"$ref":"#/$defs/VectorV1"},
        "expiresAt": {"$ref":"#/$defs/Time"},
        "lineage": {"type":"array","items":{"$ref":"#/$defs/RefV1"},"maxItems":64}
      },
      "required": ["installationId","ownerGeneration","conversation","policy","policyHash","purpose","bots","resources","selections","selectionPin","recipients","budget","continuityId","continuityGeneration","ceiling","expiresAt","lineage"],
      "additionalProperties": false
    },
    "InterpretationV1": {
      "type": "object",
      "properties": {
        "contract": {"const":"s15-conversation-interpretation/v1"},
        "ref": {"$ref":"#/$defs/RefV1"},
        "ingress": {"$ref":"#/$defs/RefV1"},
        "receiptHash": {"$ref":"#/$defs/Hash"},
        "policy": {"$ref":"#/$defs/RefV1"},
        "policyHash": {"$ref":"#/$defs/Hash"},
        "purpose": {"$ref":"#/$defs/RefV1"},
        "bot": {"$ref":"#/$defs/RefV1"},
        "selection": {"$ref":"#/$defs/SelectionV1"},
        "recipients": {"type":"array","items":{"$ref":"#/$defs/RefV1"},"maxItems":64},
        "sources": {"type":"array","items":{"$ref":"#/$defs/RefV1"},"maxItems":64},
        "budget": {"$ref":"#/$defs/RefV1"},
        "upperBound": {"$ref":"#/$defs/VectorV1"},
        "costBasis": {"$ref":"#/$defs/BlobV1"},
        "expiresAt": {"$ref":"#/$defs/Time"},
        "maxModelCalls": {"type":"integer","minimum":1,"maximum":4},
        "maxBytes": {"type":"integer","minimum":1,"maximum":262144},
        "hash": {"$ref":"#/$defs/Hash"}
      },
      "required": ["contract","ref","ingress","receiptHash","policy","policyHash","purpose","bot","selection","recipients","sources","budget","upperBound","costBasis","expiresAt","maxModelCalls","maxBytes","hash"],
      "additionalProperties": false
    },
    "ActionBindingV1": {
      "type": "object",
      "properties": {
        "id": {"$ref":"#/$defs/Id"},
        "revision": {"$ref":"#/$defs/Pos"},
        "actionHash": {"$ref":"#/$defs/Hash"},
        "policy": {"$ref":"#/$defs/RefV1"},
        "policyHash": {"$ref":"#/$defs/Hash"},
        "work": {"$ref":"#/$defs/RefV1"},
        "purpose": {"$ref":"#/$defs/RefV1"},
        "recipients": {"type":"array","items":{"$ref":"#/$defs/RefV1"},"maxItems":64},
        "payload": {"$ref":"#/$defs/BlobV1"},
        "expiresAt": {"$ref":"#/$defs/Time"}
      },
      "required": ["id","revision","actionHash","policy","policyHash","work","purpose","recipients","payload","expiresAt"],
      "additionalProperties": false
    },
    "MeaningV1": {"enum":["answer","accept_obligation","inspect","execute","select_start","material_ambiguity","approve_action","deny_action"]},
    "ProposalV1": {
      "type": "object",
      "properties": {
        "contract": {"const":"s15-conversation-proposal/v1"},
        "ingress": {"$ref":"#/$defs/RefV1"},
        "meaning": {"$ref":"#/$defs/MeaningV1"},
        "purpose": {"anyOf":[{"$ref":"#/$defs/RefV1"},{"type":"null"}]},
        "subject": {"anyOf":[{"$ref":"#/$defs/SubjectV1"},{"type":"null"}]},
        "outcome": {"$ref":"#/$defs/BlobV1"},
        "completion": {"$ref":"#/$defs/BlobV1"},
        "bots": {"type":"array","items":{"$ref":"#/$defs/RefV1"},"maxItems":64},
        "resources": {"type":"array","items":{"$ref":"#/$defs/RefV1"},"maxItems":64},
        "selections": {"type":"array","items":{"$ref":"#/$defs/SelectionV1"},"maxItems":64},
        "recipients": {"type":"array","items":{"$ref":"#/$defs/RefV1"},"maxItems":64},
        "spans": {"type":"array","items":{"$ref":"#/$defs/SpanV1"},"maxItems":64},
        "heldAction": {"anyOf":[{"$ref":"#/$defs/ActionBindingV1"},{"type":"null"}]},
        "hash": {"$ref":"#/$defs/Hash"}
      },
      "required": ["contract","ingress","meaning","purpose","subject","outcome","completion","bots","resources","selections","recipients","spans","heldAction","hash"],
      "additionalProperties": false
    },
    "AdmissionV1": {
      "type": "object",
      "properties": {
        "contract": {"const":"s15-conversation-admission/v1"},
        "ref": {"$ref":"#/$defs/RefV1"},
        "rootIngress": {"$ref":"#/$defs/RefV1"},
        "requestIngress": {"$ref":"#/$defs/RefV1"},
        "receiptHash": {"$ref":"#/$defs/Hash"},
        "proposalHash": {"$ref":"#/$defs/Hash"},
        "intent": {"$ref":"#/$defs/MeaningV1"},
        "state": {"enum":["queued","accepted","reply_only","held","approval_recorded","denied"]},
        "purpose": {"anyOf":[{"$ref":"#/$defs/RefV1"},{"type":"null"}]},
        "outcome": {"$ref":"#/$defs/BlobV1"},
        "completion": {"$ref":"#/$defs/BlobV1"},
        "subject": {"anyOf":[{"$ref":"#/$defs/SubjectV1"},{"type":"null"}]},
        "current": {"$ref":"#/$defs/CurrentV1"},
        "work": {"anyOf":[{"$ref":"#/$defs/RefV1"},{"type":"null"}]},
        "workAuthorityHash": {"anyOf":[{"$ref":"#/$defs/Hash"},{"type":"null"}]},
        "queueId": {"anyOf":[{"$ref":"#/$defs/Id"},{"type":"null"}]},
        "hold": {"anyOf":[{"$ref":"#/$defs/RefV1"},{"type":"null"}]},
        "createdAt": {"$ref":"#/$defs/Time"},
        "hash": {"$ref":"#/$defs/Hash"}
      },
      "required": ["contract","ref","rootIngress","requestIngress","receiptHash","proposalHash","intent","state","purpose","outcome","completion","subject","current","work","workAuthorityHash","queueId","hold","createdAt","hash"],
      "additionalProperties": false
    },
    "HoldV1": {
      "type": "object",
      "properties": {
        "contract": {"const":"s15-conversation-hold/v1"},
        "ref": {"$ref":"#/$defs/RefV1"},
        "rootIngress": {"$ref":"#/$defs/RefV1"},
        "requestHash": {"$ref":"#/$defs/Hash"},
        "proposalHash": {"$ref":"#/$defs/Hash"},
        "code": {"$ref":"#/$defs/CodeV1"},
        "missing": {"enum":["subject","scope","recipient","direction","authentication","policy","action"]},
        "action": {"anyOf":[{"$ref":"#/$defs/ActionBindingV1"},{"type":"null"}]},
        "createdAt": {"$ref":"#/$defs/Time"},
        "expiresAt": {"$ref":"#/$defs/Time"},
        "hash": {"$ref":"#/$defs/Hash"}
      },
      "required": ["contract","ref","rootIngress","requestHash","proposalHash","code","missing","action","createdAt","expiresAt","hash"],
      "additionalProperties": false
    },
    "ContextPacketV1": {
      "type": "object",
      "properties": {
        "request": {"$ref":"#/$defs/RefV1"},
        "planHash": {"$ref":"#/$defs/Hash"},
        "sources": {"type":"array","items":{"$ref":"#/$defs/SourceV1"},"maxItems":64},
        "decisions": {"type":"array","items":{"$ref":"#/$defs/RefV1"},"maxItems":64},
        "omitted": {"type":"array","items":{"$ref":"#/$defs/RefV1"},"maxItems":64},
